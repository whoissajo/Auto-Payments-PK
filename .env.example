# Auto-Payments-PK - local development template
# Put real values in Vercel Environment Variables or an untracked local .env.
# Never commit secrets.

# Required: generate a unique random secret with at least 32 characters.
API_SECRET_KEY=replace-with-a-long-random-secret-minimum-32-characters

# Required: dedicated mailbox receiving payment notification emails.
# For Gmail, use a Google App Password if your account supports it.
GMAIL_ADDRESS=payments-alerts@example.com
GMAIL_APP_PASSWORD=replace-with-mailbox-app-password

# Required: Supabase project and server-side privileged key.
# SUPABASE_SERVICE_ROLE_KEY may contain a legacy service_role JWT or modern sb_secret_ key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Public/client-side key used only to subscribe to payment status via Supabase Realtime.
# Prefer the new sb_publishable_ key. SUPABASE_ANON_KEY is accepted for legacy projects.
SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key

# Required only for /api/generate and /api/genrate. Use the exact dynamic payment URI
# format supplied/approved by your bank or payment provider. Use {amount} and optionally
# {reference}; the API URL-encodes both placeholders. Do not invent a payment URI.
PAYMENT_QR_PAYLOAD_TEMPLATE=

# Optional comma-separated frontend origins allowed to call GET /api/status directly.
# Example: PAYMENT_ALLOWED_ORIGINS=https://checkout.example.com
PAYMENT_ALLOWED_ORIGINS=

# Optional IMAP settings.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=INBOX
IMAP_TIMEOUT_SECONDS=8

# Optional profile overrides. BANK_ADAPTERS_JSON.json is loaded automatically.
# Values in BANK_ADAPTERS_JSON replace matching profile slugs; they do not replace the entire catalogue.
# Set as one-line JSON in Vercel. Enable only adapters with a tested exact sender and parser.
# BANK_ADAPTERS_JSON={"my-bank":{"name":"My Bank","sender_allowlist":["alerts@example-bank.test"],"transaction_id_regex":"Transaction ID\\s*[:#-]?\\s*([A-Z0-9-]{8,40})","amount_regex":"Amount Credited\\s*[:#-]?\\s*(?:PKR|Rs\\.?\\s*)?([0-9,]+(?:\\.[0-9]{1,2})?)"}}
