# Auto-Payments-PK - local development template
# Put real values in Vercel Environment Variables or an untracked local .env.
# Never commit secrets.

# Required: generate a unique random secret with at least 32 characters.
API_SECRET_KEY=replace-with-a-long-random-secret-minimum-32-characters

# Required: dedicated mailbox receiving payment notification emails.
# For Gmail, use a Google App Password if your account supports it.
GMAIL_ADDRESS=payments-alerts@example.com
GMAIL_APP_PASSWORD=replace-with-mailbox-app-password

# Required: Supabase project and server-side privileged key.
# SUPABASE_SERVICE_ROLE_KEY may contain a legacy service_role JWT or modern sb_secret_ key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Optional IMAP settings.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=INBOX
IMAP_TIMEOUT_SECONDS=8

# Optional custom bank adapters.
# Set as one-line JSON in Vercel. Each adapter must use an exact sender allowlist.
# BANK_ADAPTERS_JSON={"my-bank":{"name":"My Bank","sender_allowlist":["alerts@example-bank.test"],"transaction_id_regex":"Transaction ID\\s*[:#-]?\\s*([A-Z0-9-]{8,40})","amount_regex":"Amount Credited\\s*[:#-]?\\s*(?:PKR|Rs\\.?\\s*)?([0-9,]+(?:\\.[0-9]{1,2})?)"}}
